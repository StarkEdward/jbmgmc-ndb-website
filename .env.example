# 🌐 Site Configuration
# The base URL of the site, used for sitemaps, robots.txt, and metadata.
NEXT_PUBLIC_SITE_URL=https://jbmgmc-nandurbar.edu.in

# 🔒 Authentication Settings
# Password for the admin login (/admin/login). Overrides database credentials if set.
# Use a strong password — minimum 12 characters, mixed case, numbers, and symbols.
# Example (generate your own): openssl rand -base64 16
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Secret key used for signing the admin session cookie.
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a random 64-character hex string. Never reuse across environments.
ADMIN_SESSION_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_32_HEX

# 🗄️ Database Settings
# Custom path where split database JSON collections, backups, and logs are stored.
# If running in Docker, map this directory to a persistent named volume or host folder.
DATABASE_PATH=./data

# 🚀 Server Port (Docker/PM2)
PORT=3000
