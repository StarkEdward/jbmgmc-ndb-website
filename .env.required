# Required environment variables for JBMGMC Nandurbar Website
# Copy this file to .env and fill in the values before running the application.

# Base URL for the website (used for sitemaps, emails, headers etc.)
NEXT_PUBLIC_SITE_URL=https://jbmgmc-nandurbar.edu.in

# Strong administrative password (minimum 16 characters recommended)
ADMIN_PASSWORD=

# Cryptographically random key (at least 64 hex characters recommended)
# You can generate a strong key using: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Custom path to database storage directory (defaults to ./data in the project root if omitted)
# DATABASE_PATH=/app/data
